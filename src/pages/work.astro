---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { experience, skills } from '../data/experience';
import { projects } from '../data/projects';
import { SITE } from '../data/site';

const companyKey = (c: string) => c.toLowerCase().replace(/[^a-z]/g, '').slice(0, 6);
const projectsFor = (company: string) => projects.filter((p) => companyKey(p.company) === companyKey(company));

const recognition = [
  { value: '2026', title: 'CTO Appreciation Award' },
  { value: '2025', title: 'Best Employee Award' },
  { value: '2025', title: 'Extraordinary Performance Award' },
];
const credentials = [
  { title: 'Speaker', body: 'Open Machine Learning Conference, Bengaluru, 2024' },
  { title: 'GATE qualified', body: '97.10 percentile' },
  { title: 'Certified Machine Learning Expert', body: 'AppliedAI, 2018' },
  { title: 'Certified Deep Reinforcement Learning Expert', body: 'Udemy, 2020' },
];
---
<BaseLayout title="Experience" description="Experience, skills, education and awards of Kamish Upadhyay, Senior GenAI / AI Architect with 9 years in AI.">
  <section class="hero">
    <div class="container">
      <span class="eyebrow reveal">{SITE.years} · {SITE.location} · {SITE.relocation}</span>
      <h1 class="headline-hero reveal">Experience.</h1>
      <p class="subhead reveal reveal-delay-1">
        Gen AI and LLM fine-tuning (SFT, PEFT, LoRA/QLoRA), prompt and context engineering, multi-turn
        dialogue, RAG and agentic workflows, delivered responsibly, explainably and end to end.
      </p>
      <div class="btn-row reveal reveal-delay-2">
        <a class="btn" href={SITE.resumeHref}>Download résumé</a>
        <a class="btn btn-outline" href="/projects/">See the projects</a>
      </div>
    </div>
    <div class="container-wide">
      <div class="hero-media reveal reveal-delay-3">
        <Photo name="lab" loading="eager" sizes="(max-width: 734px) 100vw, 1100px" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="headline reveal">Where I’ve worked.</h2>
      <ol class="timeline">
        {experience.map((r) => {
          const related = projectsFor(r.company);
          return (
            <li class="reveal">
              <div class="when">{r.period}<span>{r.location}</span></div>
              <div>
                <h3>{r.title}</h3>
                <p class="company">{r.company}</p>
                <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
                {related.length > 0 && (
                  <p style="margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px 22px;">
                    {related.map((p) => <a class="more" href={`/projects/${p.slug}/`}>{p.title}</a>)}
                  </p>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section section-alt" id="skills">
    <div class="container-wide">
      <div class="center" style="margin-bottom: 48px;">
        <h2 class="headline reveal">Skills.</h2>
        <p class="subhead reveal">The toolkit behind the work.</p>
      </div>
      <div class="tiles tiles-3">
        {Object.entries(skills).map(([group, items], i) => (
          <div class:list={['card reveal', `reveal-delay-${i % 3}`]}>
            <h3 style="margin-top: 0;">{group}</h3>
            <ul class="chips" style="margin-top: 14px;">
              {items.map((s) => <li style="background: var(--bg-alt);">{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark" id="recognition">
    <div class="container center">
      <h2 class="headline reveal">Recognition.</h2>
      <div class="stats stats-3 reveal">
        {recognition.map((r) => (
          <div>
            <span class="stat-value gradient-text">{r.value}</span>
            <span class="stat-label">{r.title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="education">
    <div class="container-wide">
      <div class="center" style="margin-bottom: 48px;">
        <h2 class="headline reveal">Education & credentials.</h2>
      </div>
      <div class="tiles">
        <div class="card reveal tile-full">
          <span class="eyebrow" style="font-size: 17px;">2014 – 2018 · Sultanpur, IN</span>
          <h3 style="font-size: 32px;">B.Tech, Information Technology</h3>
          <p>Kamla Nehru Institute of Technology (KNIT). Relevant courses: Applied Machine Learning, AI, OOP, Data Structures, Algorithms, Databases, Operating Systems.</p>
        </div>
        {credentials.map((c, i) => (
          <div class:list={['card reveal', `reveal-delay-${i % 2}`]}>
            <h3 style="margin-top: 0;">{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt center">
    <div class="container">
      <h2 class="headline-md reveal">Advisory & consulting.</h2>
      <p class="subhead reveal" style="max-width: 760px; margin: 0 auto;">
        A limited number of engagements outside my full-time role: architecture reviews for RAG and
        agentic systems, LLM evaluation and fine-tuning strategy, and AI-talent or vendor sourcing.
      </p>
      <div class="btn-row reveal"><a class="btn" href="/contact/">Get in touch</a></div>
    </div>
  </section>
</BaseLayout>

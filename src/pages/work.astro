---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, skills } from '../data/experience';
import { SITE } from '../data/site';
---
<BaseLayout title="Work" cmd="cat experience.log" description="Experience, skills, and consulting availability for Kamish Upadhyay, Senior GenAI / AI Architect.">
  <h1>Work</h1>
  <p class="soft">{SITE.years} across AI research, applied ML, and enterprise GenAI architecture in financial services. {SITE.relocation}.</p>
  <div class="button-row">
    <a class="btn" href={SITE.resumeHref}>download résumé</a>
  </div>

  <h2>experience</h2>
  {experience.map((role) => (
    <div class="entry">
      <h3>{role.title} @ {role.company}</h3>
      <p class="meta" style="margin: 0 0 6px;">{role.period} · {role.location}</p>
      <ul class="arrows">
        {role.bullets.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  ))}

  <h2>skills</h2>
  <div class="indent">
    {Object.entries(skills).map(([group, items]) => (
      <p class="kv"><span class="k">{group}:</span> {items.join(', ')}</p>
    ))}
  </div>

  <h2>education</h2>
  <ul class="arrows indent">
    <li>B.Tech, Information Technology: Kamla Nehru Institute of Technology (KNIT), Sultanpur, IN (2014–2018)</li>
  </ul>

  <h2>certifications &amp; conferences</h2>
  <ul class="arrows indent">
    <li>Certified Machine Learning Expert, AppliedAI ('18)</li>
    <li>GATE Qualified, 97.10 percentile</li>
    <li>Certified Deep Reinforcement Learning Expert, Udemy ('20)</li>
    <li>Speaker, Open Machine Learning Conference, Bengaluru ('24)</li>
  </ul>

  <h2>honors &amp; awards</h2>
  <ul class="arrows indent">
    <li>Extraordinary Performance Award ('25)</li>
    <li>Best Employee Award ('25)</li>
    <li>CTO Appreciation Award ('26)</li>
  </ul>

  <h2>products &amp; consulting</h2>
  <p class="indent">
    I take on a limited number of advisory and delivery engagements outside my
    full-time role: architecture reviews for RAG/agentic systems, LLM evaluation
    and fine-tuning strategy, and AI-vendor or AI-talent sourcing for teams
    building out a GenAI function.
  </p>
  <div class="indent"><a class="btn" href="/contact/">get in touch</a></div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import PostCard from '../../components/PostCard.astro';
import { IMAGES, type ImageKey } from '../../data/images';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [latest, ...rest] = posts;
const latestImage: ImageKey =
  latest?.data.image && latest.data.image in IMAGES ? (latest.data.image as ImageKey) : 'laptop-desk';
---
<BaseLayout title="Writing" description="Writing by Kamish Upadhyay on production GenAI: fraud detection, voice agents, RAG, Text-to-SQL and fine-tuning.">
  <section class="hero" style="padding-bottom: 60px;">
    <div class="container">
      <h1 class="headline-hero reveal">Writing.</h1>
      <p class="subhead reveal reveal-delay-1">
        Field notes on building GenAI systems that hold up in production, and the
        decisions behind them.
      </p>
    </div>
  </section>

  {posts.length === 0 && <p class="center muted">No posts yet. Check back soon.</p>}

  {latest && (
    <section class="section section-alt" style="padding-top: 60px;">
      <div class="container-wide">
        <a class="tile tile-full tile-dark reveal" href={`/blog/${latest.id}/`} style="margin-bottom: 20px;">
          <div class="tile-body">
            <span class="eyebrow">Latest · {latest.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <h2 class="headline">{latest.data.title}</h2>
            <p class="subhead" style="max-width: 760px; margin: 0 auto;">{latest.data.description}</p>
            <span class="more">Read the post</span>
          </div>
          <div class="tile-media"><Photo name={latestImage} alt="" sizes="(max-width: 734px) 100vw, 1100px" /></div>
        </a>
        <div class="tiles tiles-3">
          {rest.map((post) => <div class="reveal"><PostCard post={post} /></div>)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

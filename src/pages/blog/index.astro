---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="Blog" cmd="ls -t ~/blog/" description="Writing on GenAI systems, agentic AI, RAG, and building AI products.">
  <h1>Blog</h1>
  <p class="soft">Notes on building GenAI systems, agentic AI, and RAG in production, and the process behind it.</p>

  {posts.length === 0 && <p class="muted">No posts yet. Check back soon.</p>}

  {posts.map((post) => (
    <div class="entry">
      <p class="meta" style="margin: 0;">{post.data.pubDate.toISOString().slice(0, 10)}</p>
      <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
      <p style="margin: 0;">{post.data.description}</p>
    </div>
  ))}
</BaseLayout>

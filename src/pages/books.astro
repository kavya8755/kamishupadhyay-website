---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books } from '../data/books';
---
<BaseLayout title="Books" cmd="ls -l ~/books/" description="Technical books by Kamish Upadhyay on agentic AI platforms, quantum computing for AI engineers, and AI leadership.">
  <h1>Books</h1>
  <p class="soft">Free to read and download.</p>

  {books.map((book) => (
    <div class="entry" id={book.slug}>
      <h3>📕 {book.title}</h3>
      <p class="meta" style="margin: 0 0 6px;">{book.edition} · {book.pages} pages</p>
      <p class="soft" style="margin-bottom: 6px;">{book.subtitle}</p>
      <p>{book.description}</p>
      <a class="btn" href={book.file} download>download pdf</a>
    </div>
  ))}
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PAGES } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const banner = `
██╗  ██╗ █████╗ ███╗   ███╗██╗███████╗██╗  ██╗
██║ ██╔╝██╔══██╗████╗ ████║██║██╔════╝██║  ██║
█████╔╝ ███████║██╔████╔██║██║███████╗███████║
██╔═██╗ ██╔══██║██║╚██╔╝██║██║╚════██║██╔══██║
██║  ██╗██║  ██║██║ ╚═╝ ██║██║███████║██║  ██║
╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝╚═╝╚══════╝╚═╝  ╚═╝`;

const highlights = [
  'Real-time fraud platform for money-mule networks (XGBoost + graph analytics + GigaChat SLM + investigation agent): 99.5% PR-AUC, 4.25ms latency, 82% lower fraud losses.',
  'Enterprise agentic AI analytics platform with LLM tool-calling and Text-to-SQL: conversational decision intelligence over sales, inventory and logistics data.',
  'LLM-driven KYC onboarding: OCR + LLM field validation, GenAI case summaries and an explainable credit-risk model, kept on the bank\'s own infrastructure.',
];
---
<BaseLayout title={SITE.name}>
  <h1 class="sr-only">{SITE.name}, {SITE.role}</h1>
  <pre class="banner" aria-hidden="true">{banner}</pre>

  <p>
    <span class="prompt">$</span> <span class="cmd">echo $ROLE</span><br />
    <strong>"{SITE.role} · {SITE.years}"</strong>
  </p>

  <h2>cat /proc/status</h2>
  <ul class="arrows indent">
    <li>Currently: Gen AI Architect at SBER Bank India, building a real-time, explainable fraud-detection platform</li>
    <li>
      Previously:
      <ul class="tree">
        <li>Lead AI Engineer at EY (agentic AI analytics, Text-to-SQL)</li>
        <li>Senior Data Scientist at Société Générale (LLM-driven KYC onboarding)</li>
        <li>Applied ML Engineer at TCS Research (NLP chatbots, Spark/Hadoop ML)</li>
        <li>Applied ML Engineer at GateOverflow (NLP sentiment analysis)</li>
      </ul>
    </li>
    <li>Focus: {SITE.tagline}</li>
    <li>Based in {SITE.location} · {SITE.relocation.toLowerCase()}</li>
    <li>Résumé: <a href={SITE.resumeHref}>Resume_Kamish_9Yrs_GenAI.pdf</a></li>
  </ul>

  <h2>ls ~/pages/</h2>
  <ul class="dirs indent">
    {PAGES.map((p) => (
      <li>📂 <a href={p.href}>{p.dir}</a> <span class="note">({p.note})</span></li>
    ))}
  </ul>

  <h2>cat ~/highlights.txt</h2>
  <ul class="dots indent">
    {highlights.map((h) => <li>{h}</li>)}
  </ul>

  {posts.length > 0 && (
    <>
      <h2>ls -t ~/blog/ | head -3</h2>
      <ul class="plain indent">
        {posts.map((post) => (
          <li>
            <span class="muted">{post.data.pubDate.toISOString().slice(0, 10)}</span>{' '}
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>cat ~/.social</h2>
  <p class="indent">
    <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> ·{' '}
    <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a> ·{' '}
    <a href={SITE.huggingface} target="_blank" rel="noopener noreferrer">Hugging Face</a> ·{' '}
    <a href={`mailto:${SITE.email}`}>Email</a> ·{' '}
    <a href="/rss.xml">RSS</a>
  </p>
</BaseLayout>

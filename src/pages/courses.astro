---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courses } from '../data/courses';
---
<BaseLayout title="Mini Courses" cmd="ls -l ~/mini-courses/" description="Free slide-deck mini courses by Kamish Upadhyay on agentic RAG, AI storage, agentic frameworks, MCP, LLM evaluation, and fine-tuning.">
  <h1>Mini Courses</h1>
  <p class="soft">Short, practical slide decks on building production GenAI systems. Free to download and use for learning or team sessions.</p>

  {courses.map((course, i) => (
    <div class="entry" id={course.slug}>
      <p class="meta" style="margin: 0;">course {String(i + 1).padStart(2, '0')} · {course.slides} slides · .pptx</p>
      <h3>📊 {course.title}</h3>
      <p class="soft" style="margin-bottom: 6px;">{course.subtitle}</p>
      <p class="meta" style="margin-bottom: 6px;">for: {course.audience}</p>
      <div style="margin-bottom: 6px;">
        {course.topics.map((t) => <span class="tag">{t}</span>)}
      </div>
      <a class="btn" href={course.file} download>download slides</a>
    </div>
  ))}
</BaseLayout>

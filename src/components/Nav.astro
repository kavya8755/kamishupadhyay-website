---
// Frosted, sticky global nav (apple.com style). Collapses to a menu under 834px.
import { SITE, PAGES } from '../data/site';

const { pathname } = Astro.url;
const isActive = (href: string) => pathname.startsWith(href);
---
<nav class="gnav" aria-label="Main">
  <div class="gnav-inner">
    <a class="gnav-brand" href="/">{SITE.name}</a>
    <button class="gnav-toggle" type="button" aria-expanded="false" aria-controls="gnav-links" aria-label="Menu">
      <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
        <path d="M1 1h16M1 6h16M1 11h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </svg>
    </button>
    <ul class="gnav-links" id="gnav-links">
      {PAGES.map((p) => (
        <li><a href={p.href} aria-current={isActive(p.href) ? 'page' : undefined}>{p.label}</a></li>
      ))}
      <li><a class="btn gnav-cta" href={SITE.resumeHref}>Résumé</a></li>
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector('.gnav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.gnav-toggle');
  toggle?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>
